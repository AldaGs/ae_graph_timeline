<?xml version="1.0" encoding="UTF-8"?>
<ExtensionManifest Version="11.0"
                   ExtensionBundleId="com.nodetimeline.panel"
                   ExtensionBundleVersion="0.1.0"
                   ExtensionBundleName="Node Timeline"
                   xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">

  <ExtensionList>
    <Extension Id="com.nodetimeline.panel" Version="0.1.0" />
  </ExtensionList>

  <ExecutionEnvironment>
    <HostList>
      <Host Name="AEFT" Version="[22.0,99.9]" />
    </HostList>
    <LocaleList>
      <Locale Code="All" />
    </LocaleList>
    <RequiredRuntimeList>
      <RequiredRuntime Name="CSXS" Version="11.0" />
    </RequiredRuntimeList>
  </ExecutionEnvironment>

  <DispatchInfoList>
    <Extension Id="com.nodetimeline.panel">
      <DispatchInfo>
        <Resources>
          <!-- Both built. dist/host.jsx is jsx/common + reader + patch
               concatenated (panel/scripts/build-host.mjs), because #include
               cannot resolve out of the installed extension folder. -->
          <MainPath>./dist/index.html</MainPath>
          <ScriptPath>./dist/host.jsx</ScriptPath>
          <CEFCommandLine>
            <Parameter>--enable-nodejs</Parameter>
            <Parameter>--mixed-context</Parameter>
            <Parameter>--allow-file-access</Parameter>
            <Parameter>--allow-file-access-from-files</Parameter>
          </CEFCommandLine>
        </Resources>
        <Lifecycle>
          <AutoVisible>true</AutoVisible>
        </Lifecycle>
        <UI>
          <Type>Panel</Type>
          <Menu>Node Timeline</Menu>
          <Geometry>
            <Size><Height>680</Height><Width>980</Width></Size>
            <MinSize><Height>360</Height><Width>520</Width></MinSize>
          </Geometry>
          <Icons />
        </UI>
      </DispatchInfo>
    </Extension>
  </DispatchInfoList>
</ExtensionManifest>
